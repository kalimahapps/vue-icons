{
	"extends": "https://raw.githubusercontent.com/kalimahapps/configs/main/.vscode/settings.json",
	"settings": {
		"git.detectSubmodules": false,
		"search.exclude": {
			"**/node_modules": true,
			"**/vendor": true,
			"**/bower_components": true,
			"**/.git": true,
			"**/tests": true,
			"**/.vscode": true,
			"**/out/**": true,
			"package-lock.json": true,
			"**/dist": true,
			"**/build": true,
			"**/coverage": true,
			"**/docs": true,
			"packages": true
		},
		"eslint.useFlatConfig": true,
		"files.exclude": {
			"**/packages/**": true,
			"**/node_modules/**": true
		}
	}
}